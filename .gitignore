node_modules/
dist/
# saved logins — never commit
.auth/
# recordings contain page text from your app; commit only if that is OK
# public/recordings/

# screenshots from failed captures (may show real data)
capture-failed-*.png

# help site: the player code is copied in from src/viewer (npm run docs / help); build output
help-site/src/tutorial-kit/
help-site/build/
help-site/.docusaurus/

# videos from npm run export
/videos/

# build output and packages of packages/ (npm run plugin:build, plugin:pack, studio:build, studio:pack)
packages/*/lib/
packages/*/dist/
packages/*/*.tgz

# folders made by npm run docusaurus / Export for Docusaurus (copy them into your site)
/exports/

# tutorials deleted in the editor (restorable; move the files back by hand, or use Undo)
/deleted/
