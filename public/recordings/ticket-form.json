"data-vite-dev-id":"C:/Users/jayke/tutorial-kit/src/components/TicketForm.css","_cssText":".tf { font-family: ui-sans-serif, system-ui, \"Segoe UI\", Roboto, Arial, sans-serif; color: rgb(15, 23, 42); background: rgb(241, 245, 249); min-height: 100vh; }.tf-top { height: 60px; background: rgb(255, 255, 255); border-bottom: 1px solid rgb(226, 232, 240); display: flex; align-items: center; justify-content: space-between; padding: 0px 32px; }.tf-logo { font-weight: 800; font-size: 20px; }.tf-user { font-size: 14px; color: rgb(100, 116, 139); }.tf-main { max-width: 900px; margin: 40px auto; padding: 0px 24px; }.tf-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }.tf-head h1 { margin: 0px; font-size: 28px; }.tf-primary { background: rgb(124, 58, 237); color: rgb(255, 255, 255); border: 0px; border-radius: 10px; padding: 12px 20px; font-size: 15px; font-weight: 600; cursor: pointer; }.tf-primary:disabled { opacity: 0.45; }.tf-ghost { background: rgb(255, 255, 255); border: 1px solid rgb(203, 213, 225); border-radius: 10px; padding: 12px 20px; font-size: 15px; font-weight: 600; cursor: pointer; }.tf-list { list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 10px; }.tf-item { background: rgb(255, 255, 255); border: 1px solid rgb(226, 232, 240); border-radius: 12px; padding: 16px 20px; display: flex; align-items: center; gap: 16px; font-size: 16px; }.tf-new { border-color: rgb(124, 58, 237); box-shadow: rgb(237, 233, 254) 0px 0px 0px 4px; animation: 0.5s ease-out 0s 1 normal none running tf-pop; }@keyframes tf-pop { \n  0% { transform: translateY(-12px); opacity: 0; }\n  100% { transform: none; opacity: 1; }\n}.tf-id { color: rgb(148, 163, 184); font-weight: 600; width: 32px; }.tf-title { flex: 1 1 0%; }.tf-badge { font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }.tf-low { background: rgb(226, 232, 240); color: rgb(51, 65, 85); }.tf-medium { background: rgb(254, 243, 199); color: rgb(146, 64, 14); }.tf-high { background: rgb(254, 226, 226); color: rgb(185, 28, 28); }.tf-overlay { position: fixed; inset: 0px; background: rgba(15, 23, 42, 0.45); display: grid; place-items: center; }.tf-modal { width: 460px; background: rgb(255, 255, 255); border-radius: 16px; padding: 28px; box-shadow: rgba(0, 0, 0, 0.25) 0px 30px 60px; }.tf-modal h2 { margin: 0px 0px 18px; font-size: 22px; }.tf-label { display: block; font-size: 14px; font-weight: 600; margin: 14px 0px 6px; color: rgb(51, 65, 85); }.tf-input { width: 100%; box-sizing: border-box; padding: 12px 14px; font-size: 15px; border: 1px solid rgb(203, 213, 225); border-radius: 10px; outline: none; }.tf-input:focus { border-color: rgb(124, 58, 237); box-shadow: rgb(237, 233, 254) 0px 0px 0px 3px; }.tf-seg { display: flex; gap: 8px; }.tf-seg button { flex: 1 1 0%; padding: 10px; border-radius: 10px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); font-size: 14px; font-weight: 600; cursor: pointer; }.tf-seg button.on { background: rgb(124, 58, 237); color: rgb(255, 255, 255); border-color: rgb(124, 58, 237); }.tf-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }"},"childNodes":[],"id":26}},{"parentId":26,"nextId":null,"node":{"type":3,"textContent":"","id":27}}]},"timestamp":1795532952081},{"type":3,"data":{"source":0,"texts":[],"attributes":[],"removes":[],"adds":[{"parentId":22,"nextId":null,"node":{"type":2,"tagName":"div","attributes":{"class":"tf"},"childNodes":[],"id":28}},{"parentId":28,"nextId":null,"node":{"type":2,"tagName":"main","attributes":{"class":"tf-main"},"childNodes":[],"id":29}},{"parentId":28,"nextId":29,"node":{"type":2,"tagName":"header","attributes":{"class":"tf-top"},"childNodes":[],"id":30}},{"parentId":30,"nextId":null,"node":{"type":2,"tagName":"div","attributes":{"class":"tf-user"},"childNodes":[],"id":31}},{"parentId":30,"nextId":31,"node":{"type":2,"tagName":"div","attributes":{"class":"tf-logo"},"childN